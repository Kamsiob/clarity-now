<?xml version="1.0" encoding="utf-8"?>
<!--
    Rhythm, 4x2. design-v3.md 12.2.

    The width floor is four cells because the row is fourteen marks and a narrower one
    would either crowd them or drop some, and dropping some would be a shorter fortnight
    reported as a fortnight. The height can come down to one cell, where the row and its
    one line still fit.

    updatePeriodMillis is zero, and this widget needs no refresh of its own: a day changes
    at most once a day and the snapshot is rewritten whenever anything happens, plus the
    periodic refresh.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_rhythm_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
